RewriteEngine On

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Interne Dateien und Verzeichnisse im Projekt-Webroot nie direkt ausliefern.
<FilesMatch "^(?:\.env(?:\..*)?|\.gitignore|\.htaccess|bootstrap\.php|README\.md|LICENSE|RELEASE_CHECKLIST\.md|zugangslink\.txt)$">
	Require all denied
</FilesMatch>

RewriteRule (^|/)(?:\.git(?:/|$)|data(?:/|$)|src(?:/|$)|Components(?:/|$)|tools(?:/|$)) - [F,L,NC]

# Kanonische URL: .php-Aufrufe dauerhaft auf saubere URLs ohne Endung umleiten.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[\s?]|$) [NC]
RewriteRule ^index\.php$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([A-Za-z0-9_-]+)\.php(?:[\s?]|$) [NC]
RewriteRule ^([A-Za-z0-9_-]+)\.php$ /$1 [R=301,L]

# Vorhandene Dateien und Ordner direkt ausliefern.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alle Anfragen über den Front-Controller leiten.
RewriteRule ^ index.php [L,QSA]
